// A type of car: `crates/sim/sim-core/src/car/file.rs` says what each field is. The Tesla Model Y
// Long Range, all-wheel drive (2025): a five-seat electric crossover with a motor on each
// axle (an induction motor in front, a permanent-magnet one behind, each through a single 9.04
// reduction and an open differential), the battery under the floor. Its figures as Tesla gives
// them and as road tests measured them: 1997 kg in running order (EU, with a driver), 4797 by 1920
// by 1624 mm, a wheelbase of 2890 mm, 255/45 R19 tyres all round, Cd 0.22, 0-100 km/h in 4.8 s, a
// top speed of 201 km/h, 100-0 km/h in some 36 m, 0.86 g on the skidpad. The axles, tracks and
// tyres are where its model (`exterior.glb`, from `source.glb` by `import.ron`) has them.
// Positions are body axes from the centre of gravity (x forward, y right, z down), metres.
//
// What it does, measured by `crates/sim/sim-core/tests/car.rs`.
(
    key: "modely",
    name: "Tesla Model Y",
    aliases: ["model-y", "tesla", "y", "ev"],
    visual: (model: "modely", driver_eye: (-0.15, -0.37, -0.70), bonnet_eye: (1.45, 0.0, -0.62)),
    mass: 2000.0,
    // Roll, pitch, yaw: a radius of gyration of some 1.37 m in pitch, 1.4 m in yaw, 0.65 m in roll.
    inertia: (850.0, 3750.0, 3950.0),
    // The battery under the floor keeps it low for its height.
    cg_height: 0.56,
    // 48 % of the weight in front. Ride frequencies some 1.4 Hz in front and 1.55 Hz behind (a
    // comfortable car's), dampers at a quarter of critical in bump and a half in rebound. It
    // understeers at the limit, its front anti-roll bar the stiffer.
    front: (
        x: 1.509, track: 1.606,
        spring: 37000.0, bump: 2100.0, rebound: 4200.0,
        bump_travel: 0.09, droop_travel: 0.10, bump_stop: 250000.0, bump_stop_gap: 0.02,
        anti_roll: 36000.0,
        camber_deg: -0.8, camber_gain_deg: -12.0, toe_deg: 0.05, bump_steer_deg: 0.0,
        roll_centre: 0.08,
        // 255/45 R19 all-season, on a 9.5-inch wheel.
        tyre: (
            radius: 0.369, width: 0.255, inertia: 1.6, vertical_stiffness: 270000.0, nominal_load: 4700.0,
            grip: 0.95, grip_longitudinal: 1.16, load_sensitivity: -0.12,
            cornering_stiffness: 29.0, cornering_peak: 1.9, slip_stiffness: 20.0,
            shape_lateral: 1.3, shape_longitudinal: 1.65, curvature_lateral: -0.5, curvature_longitudinal: 0.2,
            combined_longitudinal: (13.0, 9.7), combined_lateral: (10.6, 7.8),
            camber_stiffness: 1.0, relaxation_lateral: 0.5, relaxation_longitudinal: 0.22, rolling_speed: 0.0000025,
        ),
    ),
    rear: (
        x: -1.393, track: 1.606,
        spring: 49000.0, bump: 2500.0, rebound: 5000.0,
        bump_travel: 0.09, droop_travel: 0.10, bump_stop: 250000.0, bump_stop_gap: 0.02,
        anti_roll: 12000.0,
        camber_deg: -1.2, camber_gain_deg: -10.0, toe_deg: 0.1, bump_steer_deg: 0.0,
        roll_centre: 0.12,
        tyre: (
            radius: 0.369, width: 0.255, inertia: 1.6, vertical_stiffness: 270000.0, nominal_load: 4700.0,
            grip: 0.99, grip_longitudinal: 1.16, load_sensitivity: -0.12,
            cornering_stiffness: 38.0, cornering_peak: 1.9, slip_stiffness: 20.0,
            shape_lateral: 1.3, shape_longitudinal: 1.65, curvature_lateral: -0.5, curvature_longitudinal: 0.2,
            combined_longitudinal: (13.0, 9.7), combined_lateral: (10.6, 7.8),
            camber_stiffness: 1.0, relaxation_lateral: 0.5, relaxation_longitudinal: 0.22, rolling_speed: 0.0000025,
        ),
    ),
    // A turning circle of 12.1 m; 2.3 turns lock to lock.
    steering: (lock_deg: 33.0, ackermann: 0.6, wheel_turns: 2.3),
    // No engine nor gearbox: two motors and the battery. Torques at the motor's shaft.
    electric: (
        motors: [
            // The front motor, an induction motor: 210 N m up to 6500 rpm, then some 140 kW.
            (axle: Front, torque: [(0.0, 210.0), (6500.0, 210.0), (8000.0, 168.0), (10000.0, 134.0), (12000.0, 108.0), (15000.0, 80.0), (18000.0, 60.0)],
             ratio: 9.036, inertia: 0.045, regen: 50.0),
            // The rear motor, permanent magnets in a switched reluctance rotor: 400 N m up to
            // 5000 rpm, then some 210 kW.
            (axle: Rear, torque: [(0.0, 400.0), (5000.0, 400.0), (7000.0, 286.0), (9000.0, 222.0), (12000.0, 165.0), (15000.0, 125.0), (18000.0, 95.0)],
             ratio: 9.036, inertia: 0.035, regen: 150.0),
        ],
        // The most the battery gives and the most it takes back (regeneration), W.
        battery_power: 300000.0,
        regen_power: 75000.0,
        // From the battery to the wheels.
        efficiency: 0.9,
        // Where its software holds it.
        top_speed_kmh: 201.0,
    ),
    // Enough to lock the wheels on dry asphalt; 0.62 of it in front.
    brakes: (torque: 9000.0, front_share: 0.62, handbrake: 1500.0, abs_slip: 0.11),
    // Cd 0.22 on 2.56 m², a little lift at both ends.
    aero: (drag_area: 0.56, lift_front: 0.04, lift_rear: 0.06, centre_height: 0.7),
    body: (
        // The body and the cabin: 4.75 by 1.92 m, the roof 1.62 m up (the ground is at z = 0.56).
        solid: [((-2.32, -0.96, -0.30), (2.43, 0.96, 0.40)), ((-1.9, -0.78, -1.06), (1.0, 0.78, -0.30))],
        contacts: [
            (2.43, -0.85, 0.32), (2.43, 0.85, 0.32), (-2.32, -0.85, 0.32), (-2.32, 0.85, 0.32),
            (1.2, -0.96, 0.25), (1.2, 0.96, 0.25), (-1.2, -0.96, 0.25), (-1.2, 0.96, 0.25),
            (0.0, -0.96, 0.25), (0.0, 0.96, 0.25),
            (0.8, -0.74, -1.06), (0.8, 0.74, -1.06), (-1.8, -0.70, -1.0), (-1.8, 0.70, -1.0),
            (2.3, 0.0, -0.1), (-2.2, 0.0, -0.2),
        ],
        crash_speed: 20.0,
    ),
)
