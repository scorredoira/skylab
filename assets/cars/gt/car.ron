// A type of car: `crates/sim/sim-core/src/car/file.rs` says what each field is. A generic two-seat
// rear-drive sports coupé with a six-cylinder engine in front of the rear axle, of no make: about
// 1400 kg with its driver, 375 hp, a six-speed sequential gearbox and a limited-slip differential.
// Its numbers are the typical ones of its class, as the books give them for such cars (Milliken &
// Milliken, Race Car Vehicle Dynamics, 1995; Gillespie, Fundamentals of Vehicle Dynamics, 1992;
// Pacejka, Tire and Vehicle Dynamics, 2012, for the tyres' formula): positions are body axes from
// the centre of gravity (x forward, y right, z down), metres.
//
// What it does, measured by `crates/sim/sim-core/tests/car.rs`, against the class's usual figures
// (road tests of such cars give 0-100 km/h in 4.3 to 5 s, 100-0 km/h in 33 to 37 m, a top speed of
// 270 to 295 km/h and 0.95 to 1.05 g on the skidpad).
(
    key: "gt",
    name: "GT coupé",
    aliases: ["coupe", "sports", "car"],
    visual: (model: "gt", driver_eye: (-0.42, -0.37, -0.585), bonnet_eye: (1.30, 0.0, -0.60)),
    mass: 1420.0,
    // Roll, pitch, yaw: a radius of gyration of some 1.25 m in yaw and pitch, 0.58 m in roll.
    inertia: (480.0, 2100.0, 2250.0),
    cg_height: 0.46,
    // 46 % of the weight in front, a wheelbase of 2.47 m. Ride frequencies about 1.7 Hz in front,
    // 1.85 Hz behind (Milliken, ch. 16); dampers at some 0.3 of critical in bump, 0.6 in rebound.
    // The balance of a road GT: it understeers at the limit, the front giving first. The front
    // carries some two thirds of the roll stiffness (its anti-roll bar the stiffer), so the front
    // tyres lose more grip to the load moved across; the wider rear tyres corner stiffer (their
    // cornering stiffness some 1.3 times the front's at the same load) and grip a little more; the
    // limited-slip differential locks lightly on power (`tests/car.rs`, the handling tests: a step
    // of steering at 100 km/h settles under 3° of sideslip).
    front: (
        x: 1.334, track: 1.55,
        spring: 33000.0, bump: 1900.0, rebound: 3800.0,
        bump_travel: 0.07, droop_travel: 0.08, bump_stop: 250000.0, bump_stop_gap: 0.015,
        anti_roll: 42000.0,
        camber_deg: -1.5, camber_gain_deg: -20.0, toe_deg: 0.05, bump_steer_deg: 0.0,
        roll_centre: 0.06,
        // 245/35 R19 on a 9-inch wheel.
        tyre: (
            radius: 0.333, width: 0.245, inertia: 1.1, vertical_stiffness: 260000.0, nominal_load: 4000.0,
            grip: 1.12, grip_longitudinal: 1.18, load_sensitivity: -0.12,
            cornering_stiffness: 31.5, cornering_peak: 1.9, slip_stiffness: 22.0,
            shape_lateral: 1.3, shape_longitudinal: 1.65, curvature_lateral: -0.5, curvature_longitudinal: 0.2,
            combined_longitudinal: (13.0, 9.7), combined_lateral: (10.6, 7.8),
            camber_stiffness: 1.0, relaxation_lateral: 0.45, relaxation_longitudinal: 0.2, rolling_speed: 0.0000025,
        ),
    ),
    rear: (
        x: -1.136, track: 1.57,
        spring: 46000.0, bump: 2400.0, rebound: 4800.0,
        bump_travel: 0.07, droop_travel: 0.08, bump_stop: 250000.0, bump_stop_gap: 0.015,
        anti_roll: 12000.0,
        camber_deg: -1.8, camber_gain_deg: -15.0, toe_deg: 0.15, bump_steer_deg: 0.0,
        roll_centre: 0.10,
        // 285/30 R19 on an 11-inch wheel.
        tyre: (
            radius: 0.333, width: 0.285, inertia: 1.3, vertical_stiffness: 280000.0, nominal_load: 4000.0,
            grip: 1.22, grip_longitudinal: 1.2, load_sensitivity: -0.12,
            cornering_stiffness: 42.0, cornering_peak: 1.9, slip_stiffness: 22.0,
            shape_lateral: 1.3, shape_longitudinal: 1.65, curvature_lateral: -0.5, curvature_longitudinal: 0.2,
            combined_longitudinal: (13.0, 9.7), combined_lateral: (10.6, 7.8),
            camber_stiffness: 1.0, relaxation_lateral: 0.45, relaxation_longitudinal: 0.2, rolling_speed: 0.0000025,
        ),
    ),
    steering: (lock_deg: 32.0, ackermann: 0.6, wheel_turns: 2.4),
    // 3.8 litres, six cylinders: 420 N m from 4500 to 5500 rpm, 280 kW (375 hp) at 7200 rpm.
    engine: (
        torque: [(800.0, 250.0), (1500.0, 300.0), (2500.0, 360.0), (3500.0, 400.0), (4500.0, 420.0), (5500.0, 420.0), (6500.0, 400.0), (7200.0, 370.0), (7800.0, 330.0), (8200.0, 290.0)],
        drag: (25.0, 9.0),
        inertia: 0.12,
        idle_rpm: 850.0, limiter_rpm: 7900.0, redline_rpm: 7500.0,
        cylinders: 6,
    ),
    // 83, 129, 170, 213, 260 and 311 km/h at the limiter.
    gearbox: (
        ratios: [3.31, 2.13, 1.62, 1.29, 1.06, 0.88], reverse: 3.0, final_drive: 3.62,
        efficiency: 0.9, shift_time: 0.12, clutch_torque: 650.0,
        auto_up_rpm: 7500.0, auto_down_rpm: 3000.0,
    ),
    differential: Limited(preload: 40.0, power: 0.15, coast: 0.2),
    drive: Rear,
    // Enough to lock the wheels on dry asphalt; two thirds of it in front, the ideal share for the
    // weight it carries braking at 1.1 g.
    brakes: (torque: 7000.0, front_share: 0.66, handbrake: 1500.0, abs_slip: 0.11),
    // Cd 0.35 on 2.05 m², a little downforce at both ends.
    aero: (drag_area: 0.72, lift_front: -0.05, lift_rear: -0.1, centre_height: 0.5),
    body: (
        // The body and the cabin: 4.4 by 1.9 m, the roof 1.28 m up (the ground is at z = 0.46).
        solid: [((-2.2, -0.95, -0.35), (2.2, 0.95, 0.34)), ((-1.0, -0.75, -0.82), (0.9, 0.75, -0.35))],
        contacts: [
            (2.2, -0.85, 0.25), (2.2, 0.85, 0.25), (-2.2, -0.85, 0.25), (-2.2, 0.85, 0.25),
            (1.1, -0.95, 0.15), (1.1, 0.95, 0.15), (-1.1, -0.95, 0.15), (-1.1, 0.95, 0.15),
            (0.0, -0.95, 0.15), (0.0, 0.95, 0.15),
            (0.8, -0.72, -0.82), (0.8, 0.72, -0.82), (-1.0, -0.72, -0.82), (-1.0, 0.72, -0.82),
            (2.0, 0.0, -0.1), (-2.1, 0.0, -0.15),
        ],
        crash_speed: 20.0,
    ),
)
